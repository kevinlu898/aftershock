{
  "expo": {
    "name": "aftershock",
    "slug": "aftershock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aftershock",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aftershock.app",
      "versionCode": 1
    },
    "output": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aftershock uses your location once to find your ZIP code for local earthquake risk."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#25745A"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aftershock uses the camera so you can save photos of important documents.",
          "photosPermission": "Aftershock accesses your photos so you can save copies of important documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e7629e9a-2a94-4d34-a5f5-28c960c1d322"
      }
    }
  }
}
